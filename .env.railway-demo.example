# Railway service "opentill-demo" — MOCK settlement, with the checkout's
# "Simulate payment" button. No real Bitcoin moves.
#
# Copy to .env.railway-demo (gitignored), fill in the blanks, then load it with
#   sh scripts/railway-load-env.sh .env.railway-demo opentill-demo
# (see RAILWAY.md). One KEY=VALUE per line; no quotes needed. Never commit the
# filled-in file.

# --- secrets (required) ----------------------------------------------------
# Merchant API key (dashboard login). openssl rand -hex 24
OPENTILL_API_KEY=replace-with-a-long-random-string
# HMAC key for webhooks. openssl rand -hex 24
OPENTILL_WEBHOOK_SECRET=replace-with-a-long-random-string

# --- settlement --------------------------------------------------------------
ADAPTER_MODE=mock

# --- demo pay button ---------------------------------------------------------
# Both are needed: the button only exists when NODE_ENV is not "production"
# (the image defaults to production) AND the flag is true. Mock adapter only.
NODE_ENV=development
OPENTILL_DEV_PUBLIC_SIMULATE=true

# --- storage: Railway volume mounted at /data ---------------------------------
OPENTILL_DB_PATH=/data/opentill.db

# --- runtime -----------------------------------------------------------------
OPENTILL_MERCHANT_NAME=Satoshi Beans
HOST=0.0.0.0
PORT=8080
# Start as root so the entrypoint can chown the volume, then drop to `node`.
RAILWAY_RUN_UID=0

# --- public URL --------------------------------------------------------------
# Optional; empty = fall back to https://$RAILWAY_PUBLIC_DOMAIN.
OPENTILL_PUBLIC_URL=
