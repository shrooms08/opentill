# Railway service "opentill-live" — REAL Tachi settlement on tachi-regtest-1.
#
# Copy to .env.railway-live (gitignored), fill in the blanks, then load it with
#   sh scripts/railway-load-env.sh .env.railway-live opentill-live
# (see RAILWAY.md). One KEY=VALUE per line; no quotes needed (the loader
# strips one pair of surrounding quotes if present). Comments/blank lines are
# skipped. Never commit the filled-in file.

# --- secrets (required) ----------------------------------------------------
# Merchant API key (dashboard login + Bearer for /api/*). openssl rand -hex 24
OPENTILL_API_KEY=replace-with-a-long-random-string
# HMAC key for X-OpenTill-Signature on webhooks. openssl rand -hex 24
OPENTILL_WEBHOOK_SECRET=replace-with-a-long-random-string
# BIP-39 mnemonic every merchant key derives from. Use a NEW one for this
# instance (never one another instance has used — the gateway refuses to boot
# on a used mnemonic with an empty volume). Generate:
#   node -e "console.log(require('bip39').generateMnemonic())"
TACHI_MNEMONIC=

# --- settlement --------------------------------------------------------------
ADAPTER_MODE=tachi
TACHI_NETWORK=regtest
TACHI_RPC_URL=https://rpc-regtest.tachibtc.com
# Optional daemon X-Api-Key (leave unset unless Tachi gave you one)
# TACHI_API_KEY=

# --- storage: both on the Railway volume mounted at /data ---------------------
OPENTILL_DB_PATH=/data/opentill.db
TACHI_STATE_PATH=/data/tachi-state.json

# --- runtime -----------------------------------------------------------------
NODE_ENV=production
# Unauthenticated demo pay button: must stay false with a real adapter
# (the gateway refuses to boot otherwise).
OPENTILL_DEV_PUBLIC_SIMULATE=false
OPENTILL_MERCHANT_NAME=Satoshi Beans (live)
HOST=0.0.0.0
# Pinned so `railway domain --port 8080` and the app agree.
PORT=8080
# Start the container as root so the entrypoint can chown the root-owned
# volume, then drop to the `node` user. Required on Railway.
RAILWAY_RUN_UID=0

# --- public URL --------------------------------------------------------------
# Absolute origin customers use, for checkoutUrl in API responses. Optional:
# when empty the gateway falls back to https://$RAILWAY_PUBLIC_DOMAIN, which
# Railway injects once the service has a generated domain.
OPENTILL_PUBLIC_URL=

# --- optional ------------------------------------------------------------------
# OPENTILL_PAYOUT_WEBHOOK_URL=https://your-backend.example/opentill-payouts
# POLL_INTERVAL_MS=2000
