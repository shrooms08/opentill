# Merchant API key. Sent as: Authorization: Bearer <key>
OPENTILL_API_KEY=5b667f6ef9cb699e8680be4e074ed726460a95ee5937d6de dev_api_key_change_me

# HMAC-SHA256 key used to sign outgoing webhook bodies (X-OpenTill-Signature)
OPENTILL_WEBHOOK_SECRET=dev_webhook_secret_change_me 

# SQLite database file path
OPENTILL_DB_PATH=./opentill.db

# Settlement adapter: "mock" | "tachi".
#   mock  — in-memory settlement, no real Bitcoin moves; the test/demo/CI adapter.
#   tachi — REAL settlement against a Tachi daemon (regtest/signet). Receiving,
#           confirmation and refunds are live on the Tachi ledger; L1 payouts /
#           unilateral exit are not implemented yet (see INTEGRATION.md).
ADAPTER_MODE=mock

# --- ADAPTER_MODE=tachi only ---------------------------------------------
# BIP-39 mnemonic every merchant key derives from (BIP-84; one fresh key per
# invoice on the change chain, receive-chain index 0 is the "till" float key).
# Generate one: node -e "console.log(require('bip39').generateMnemonic())"
# TACHI_MNEMONIC="word word word ... (12 or 24 words)"
# TACHI_NETWORK=regtest            # regtest | signet
# TACHI_RPC_URL=https://rpc-regtest.tachibtc.com   # or https://rpc-signet.tachibtc.com
# TACHI_API_KEY=                   # optional daemon X-Api-Key
# TACHI_STATE_PATH=./tachi-adapter.json   # handed-out keys + watched addresses (default: next to the DB)

# Storefront name shown to customers in the checkout header (and POS).
OPENTILL_MERCHANT_NAME=OpenTill

# HTTP port
PORT=8080

# Expose unauthenticated POST /dev/pay/:invoiceId (checkout demo button).
# Only honored with ADAPTER_MODE=mock outside production; the gateway refuses
# to boot if this is true with any other adapter.
OPENTILL_DEV_PUBLIC_SIMULATE=false

# Merchant-level webhook for payout status changes (optional)
# OPENTILL_PAYOUT_WEBHOOK_URL=https://your-backend.example/opentill-payouts

# Host port mapping used by docker-compose.yml (container always listens on 8080)
# OPENTILL_PORT=8080

# Optional tuning
# POLL_INTERVAL_MS=2000
# EXPIRY_SWEEP_INTERVAL_MS=10000
# WEBHOOK_SWEEP_INTERVAL_MS=5000
# SSE_HEARTBEAT_MS=15000
# PAYOUT_POLL_INTERVAL_MS=2000
# OPENTILL_WEB_DIST=/path/to/apps/web/dist
